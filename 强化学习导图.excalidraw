      "type": "text",
      "x": -370.92044934653745,
      "y": 1678.7064968873744,
      "width": 501.8399963378906,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
